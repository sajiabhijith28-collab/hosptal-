# Database Connection URL
# For local development with SQLite:
# DATABASE_URL="file:./dev.db"
#
# For Vercel production deployment with PostgreSQL (Neon / Supabase / Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/ente_hospital?sslmode=require"

DATABASE_URL="file:./dev.db"

# NextAuth Secret: Random secure secret key for signing session tokens
NEXTAUTH_SECRET="ente-hospital-secret-auth-key-production-3948572"

# NextAuth URL: Your production domain on Vercel or localhost in development
NEXTAUTH_URL="http://localhost:3000"

# Direct UPI & QR Code Payment Configuration
NEXT_PUBLIC_CLINIC_UPI_ID="9495821891@ybl"
NEXT_PUBLIC_CLINIC_UPI_NAME="Ente Hospital"
